{
  "name": "alphanana",
  "version": "0.2.0",
  "description": "Transparent PNG generation with Gemini image models (nano banana): exact difference-matte alpha, quality guards, style-locked variants and manifest-driven batches.",
  "keywords": [
    "gemini",
    "nano-banana",
    "image-generation",
    "transparency",
    "alpha-matte",
    "difference-matte",
    "png",
    "assets"
  ],
  "type": "module",
  "license": "MIT",
  "author": "Tobias Strebitzer",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tobiasstrebitzer/alphanana.git"
  },
  "homepage": "https://github.com/tobiasstrebitzer/alphanana#readme",
  "bugs": "https://github.com/tobiasstrebitzer/alphanana/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "main": "./build/index.mjs",
  "types": "./build/index.d.mts",
  "bin": {
    "alphanana": "./build/cli.mjs"
  },
  "files": [
    "build"
  ],
  "exports": {
    ".": {
      "types": "./build/index.d.mts",
      "default": "./build/index.mjs"
    }
  },
  "scripts": {
    "clean": "rimraf build",
    "build": "tsdown",
    "prepack": "pnpm clean && pnpm build",
    "typecheck": "tsgo -p tsconfig.json",
    "lint": "oxlint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "sharp": "^0.35.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "oxlint": "^1.0.0",
    "rimraf": "^6.1.3",
    "tsdown": "^0.21.10",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
